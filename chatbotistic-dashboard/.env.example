# ─────────────────────────────────────────────────────────────────────
# Chatbotistic Dashboard — environment variables
# Copy this file to `.env.local` (local dev) and fill in real values.
# ─────────────────────────────────────────────────────────────────────

# Supabase
# Project URL + anon key are public (safe to expose to the browser).
# The service-role key is server-only — never expose it to the client.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Tochat.be (white-labeled WhatsApp widget / lead / booking backend)
# TOCHAT_API_BASE defaults to https://services.tochat.be if unset.
# TOCHAT_API_EMAIL / TOCHAT_API_PASSWORD are the master account used to
# mint the JWT for all `/api/tochat/*` and `/api/leads` proxy routes.
# TOCHAT_LEAD_API_KEY is a separate, long-lived key used only for the
# lead export endpoint (GET /api/get-json-lead).
TOCHAT_API_BASE=https://services.tochat.be
TOCHAT_API_EMAIL=
TOCHAT_API_PASSWORD=
TOCHAT_LEAD_API_KEY=

# SSO bridge (chatbotistic.com Memberistic/Licenseistic → this app)
# Shared HMAC secret used to verify the short-lived SSO token minted by
# the WordPress plugins. SSO_MAX_SKEW_SECONDS bounds token freshness
# (defaults to 300 seconds if unset).
SSO_SHARED_SECRET=
SSO_MAX_SKEW_SECONDS=300

# Encryption (WhatsApp credentials at rest — AES-256-GCM)
# Must be exactly 64 hex characters (32 bytes). Generate with:
#   openssl rand -hex 32
ENCRYPTION_KEY=

# App
# Public origin used to build absolute redirect URLs (e.g. the SSO
# bridge's post-login redirect). Falls back to the request origin if
# unset.
NEXT_PUBLIC_SITE_URL=https://dashboard.chatbotistic.com
